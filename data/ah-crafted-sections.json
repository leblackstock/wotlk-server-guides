  "guides": {
    "inscription-materials-ah-price-guide.html": {
      "sections": [
        {"title": "Crafted buff scrolls", "description": "Manufactured raid and stat consumables. Rank VIII stat scrolls can also drop, but the finished items are identical and AH-tradeable.", "items": ["scroll-agility-viii", "scroll-intellect-viii", "scroll-spirit-viii", "scroll-stamina-viii", "scroll-strength-viii", "runescroll-fortitude"]},
        {"title": "Crafted utility and BoE equipment", "description": "Tradeable Inscription outputs beyond glyphs and cards. BoP shoulder inscriptions and scribe-only recall scrolls are intentionally excluded.", "items": ["armor-vellum", "weapon-vellum", "certificate-ownership", "iron-bound-tome", "faces-doom"]},
        {"title": "Death Knight glyphs", "description": "Curated level-80 raid and tanking demand.", "items": ["glyph-disease", "glyph-dark-death", "glyph-death-strike", "glyph-icy-touch", "glyph-rune-strike", "glyph-vampiric-blood"]},
        {"title": "Druid glyphs", "description": "Curated Balance, Feral, Restoration, and tank demand.", "items": ["glyph-starfire", "glyph-insect-swarm", "glyph-rapid-rejuvenation", "glyph-wild-growth", "glyph-savage-roar", "glyph-maul"]},
        {"title": "Hunter glyphs", "description": "Curated level-80 PvE demand across the common Hunter builds.", "items": ["glyph-explosive-shot", "glyph-kill-shot", "glyph-serpent-sting", "glyph-steady-shot", "glyph-chimera-shot", "glyph-bestial-wrath"]},
        {"title": "Mage glyphs", "description": "Curated Arcane, Fire, Frostfire, and utility demand.", "items": ["glyph-arcane-blast", "glyph-arcane-missiles", "glyph-fireball", "glyph-living-bomb", "glyph-molten-armor", "glyph-frostfire"]},
        {"title": "Paladin glyphs", "description": "Curated Protection, Holy, and Retribution demand.", "items": ["glyph-seal-vengeance", "glyph-divine-plea", "glyph-righteous-defense", "glyph-hammer-righteous", "glyph-holy-light", "glyph-beacon-light"]},
        {"title": "Priest glyphs", "description": "Curated Shadow, Discipline, and Holy demand.", "items": ["glyph-mind-flay", "glyph-dispersion", "glyph-penance", "glyph-power-word-shield", "glyph-guardian-spirit", "glyph-circle-healing"]},
        {"title": "Rogue glyphs", "description": "Curated Assassination and Combat demand.", "items": ["glyph-mutilate", "glyph-hunger-blood", "glyph-tricks-trade", "glyph-sinister-strike", "glyph-killing-spree", "glyph-eviscerate"]},
